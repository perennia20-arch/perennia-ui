            return json({ error: 'STRATUM REDIS ERROR: CANNOT BIND MINING ADDRESS' }, { status: 500 });
        }

        return json({ success: true, message: 'STRATUM SUCCESSFULLY BOUND' }, { status: 200 });

    } catch (err: any) {
        console.error("Stratum Binding API Error:", err);
