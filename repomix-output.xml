        if (!cleanAddress.startsWith('kaspa:')) {
            return json({ error: 'INVALID FORMAT: MISSING "kaspa:" PREFIX' }, { status: 400 });
        }

        if (cleanAddress.length < 60) {
            return json({ error: 'INVALID FORMAT: ADDRESS LENGTH INCORRECT' }, { status: 400 });
